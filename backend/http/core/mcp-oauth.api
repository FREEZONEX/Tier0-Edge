syntax = "v1"

// 标准 OAuth 字段遵循 RFC；不使用业务 Envelope/小驼峰替换协议字段。
type McpOAuthRegisterReq {
    ClientName string `json:"client_name,optional"`
    RedirectUris []string `json:"redirect_uris"`
    TokenEndpointAuthMethod string `json:"token_endpoint_auth_method,optional"`
    GrantTypes []string `json:"grant_types,optional"`
    ResponseTypes []string `json:"response_types,optional"`
    Scope string `json:"scope,optional"`
}
type McpOAuthAuthorizeReq {
    ResponseType string `form:"response_type"`
    ClientId string `form:"client_id"`
    RedirectUri string `form:"redirect_uri"`
    Resource string `form:"resource"`
    Scope string `form:"scope,optional"`
    State string `form:"state"`
    CodeChallenge string `form:"code_challenge"`
    CodeChallengeMethod string `form:"code_challenge_method"`
}
type McpOAuthTokenReq {
    GrantType string `form:"grant_type" json:"grant_type"`
    ClientId string `form:"client_id" json:"client_id"`
    Resource string `form:"resource" json:"resource"`
    Code string `form:"code,optional" json:"code,optional"`
    RedirectUri string `form:"redirect_uri,optional" json:"redirect_uri,optional"`
    CodeVerifier string `form:"code_verifier,optional" json:"code_verifier,optional"`
    RefreshToken string `form:"refresh_token,optional" json:"refresh_token,optional"`
    Scope string `form:"scope,optional" json:"scope,optional"`
}
type McpOAuthRevokeReq {
    ClientId string `form:"client_id" json:"client_id"`
    Token string `form:"token" json:"token"`
    TokenTypeHint string `form:"token_type_hint,optional" json:"token_type_hint,optional"`
}
type McpOAuthProtocolResponse {
    Data map[string]interface{} `json:"-"`
}
type McpOAuthTokenResp {
    AccessToken string `json:"access_token"`
    TokenType string `json:"token_type"`
    ExpiresIn int64 `json:"expires_in"`
    Scope string `json:"scope"`
    RefreshToken string `json:"refresh_token,optional"`
}
type McpOAuthRegisterResp {
    ClientId string `json:"client_id"`
    ClientName string `json:"client_name"`
    ClientIdIssuedAt int64 `json:"client_id_issued_at"`
    RedirectUris []string `json:"redirect_uris"`
    TokenEndpointAuthMethod string `json:"token_endpoint_auth_method"`
    GrantTypes []string `json:"grant_types"`
    ResponseTypes []string `json:"response_types"`
    Scope string `json:"scope"`
}
type McpOAuthResourceResp {
    Resource string `json:"resource"`
    ResourceName string `json:"resource_name"`
    AuthorizationServers []string `json:"authorization_servers"`
    ScopesSupported []string `json:"scopes_supported"`
    BearerMethodsSupported []string `json:"bearer_methods_supported"`
}
type McpOAuthServerResp {
    Issuer string `json:"issuer"`
    AuthorizationEndpoint string `json:"authorization_endpoint"`
    TokenEndpoint string `json:"token_endpoint"`
    RegistrationEndpoint string `json:"registration_endpoint"`
    RevocationEndpoint string `json:"revocation_endpoint"`
    ResponseTypesSupported []string `json:"response_types_supported"`
    GrantTypesSupported []string `json:"grant_types_supported"`
    TokenEndpointAuthMethodsSupported []string `json:"token_endpoint_auth_methods_supported"`
    RevocationEndpointAuthMethodsSupported []string `json:"revocation_endpoint_auth_methods_supported"`
    CodeChallengeMethodsSupported []string `json:"code_challenge_methods_supported"`
    ScopesSupported []string `json:"scopes_supported"`
    AuthorizationResponseIssParameterSupported bool `json:"authorization_response_iss_parameter_supported"`
    ClientIdMetadataDocumentSupported bool `json:"client_id_metadata_document_supported"`
}
type McpOAuthRequestReq {
    RequestId string `form:"requestId"`
}
type McpOAuthDecisionReq {
    RequestId string `json:"requestId"`
    Allow bool `json:"allow"`
    Scopes []string `json:"scopes,optional"`
}
type McpOAuthGrantRevokeReq {
    GrantId string `json:"grantId"`
}

@server(
    prefix: "/.well-known"
    group: core/mcpoauth
    maxBytes: 16384
    timeout: 15s
)
service backend {
    @handler McpOAuthResourceMetadata
    get /oauth-protected-resource returns (McpOAuthResourceResp)
    @handler McpOAuthPathResourceMetadata
    get /oauth-protected-resource/mcp returns (McpOAuthResourceResp)
    @handler McpOAuthServerMetadata
    get /oauth-authorization-server returns (McpOAuthServerResp)
    // 路径代理下支持 RFC 8414/OIDC appending discovery 回退。
    @handler McpOAuthServerMetadataAlias
    get /openid-configuration returns (McpOAuthServerResp)
}

@server(
    group: core/mcpoauth
    maxBytes: 16384
    timeout: 15s
)
service backend {
    @handler McpOAuthRegister
    post /mcp/oauth/register (McpOAuthRegisterReq) returns (McpOAuthRegisterResp)
    @handler McpOAuthAuthorize
    get /mcp/oauth/authorize (McpOAuthAuthorizeReq) returns (McpOAuthProtocolResponse)
    @handler McpOAuthToken
    post /mcp/oauth/token (McpOAuthTokenReq) returns (McpOAuthTokenResp)
    @handler McpOAuthRevoke
    post /mcp/oauth/revoke (McpOAuthRevokeReq) returns (McpOAuthProtocolResponse)
}

// 本人授权操作是 login-only；固定 session 用户与浏览器绑定，不能代理他人授权。
@server(
    prefix: /api/core/mcp/oauth
    group: core/mcpoauth
    middleware: SessionAuth
    maxBytes: 16384
    timeout: 15s
)
service backend {
    @handler McpOAuthRequest
    get /request (McpOAuthRequestReq) returns (Envelope)
    @handler McpOAuthDecision
    post /decision (McpOAuthDecisionReq) returns (Envelope)
    @handler McpOAuthGrants
    get /grants returns (Envelope)
    @handler McpOAuthGrantRevoke
    post /grants/revoke (McpOAuthGrantRevokeReq) returns (Envelope)
}
