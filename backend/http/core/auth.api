syntax = "v1"

@server(
    prefix: /api/core/auth
    group: core/auth
)
service backend {
    // Public static bridge and single-use exchange; the ticket is the credential.
    @handler MiniEntry
    get /mini-entry

    @handler MiniEntryExchange
    post /mini-entry-exchange (MiniEntryExchangeReq) returns (Envelope)

    @handler Login
    post /login (LoginReq) returns (Envelope)

    @handler ExternalSSOStart
    get /sso/:provider/start (ExternalSSOStartReq)

    @handler ExternalSSOCallback
    get /sso/:provider/callback (ExternalSSOCallbackReq)

    @handler ExternalSSOPending
    get /sso/:provider/pending (ExternalSSOPendingReq) returns (Envelope)

    @handler ExternalSSOUsernameAvailability
    get /sso/:provider/username-availability (ExternalSSOUsernameAvailabilityReq) returns (Envelope)

    @handler ExternalSSOComplete
    post /sso/:provider/complete (ExternalSSOCompleteReq) returns (Envelope)

    @handler ExternalSSOLink
    post /sso/:provider/link (ExternalSSOLinkReq) returns (Envelope)
}

@server(
    prefix: /api/core/auth
    group: core/auth
    middleware: SessionAuth
)
service backend {
    // Login-only self-session handoff; logic reuses Launchpad permission and app checks.
    @handler MiniEntryTicket
    post /mini-entry-ticket (MiniEntryTicketReq) returns (Envelope)

    @handler CurrentUser
    get /me returns (Envelope)

    @handler Logout
    post /logout returns (Envelope)

    @handler CurrentUserConfigGet
    get /config returns (Envelope)

    @handler CurrentUserConfigPatch
    patch /config (CurrentUserConfigReq) returns (Envelope)

    @handler CurrentUserConfigPut
    put /config (CurrentUserConfigReq) returns (Envelope)

    @handler CurrentUserProfileUpdate
    put /profile (CurrentUserProfileReq) returns (Envelope)

    @handler CurrentUserPasswordUpdate
    put /password (CurrentUserPasswordReq) returns (Envelope)
}
