syntax = "v1"

type SystemLoginSessionDurationReq {
    duration string `json:"duration"`
}

@server(
    group: core/system
)
service backend {
    @handler Healthz
    get /healthz returns (Envelope)

    @handler Readyz
    get /readyz returns (Envelope)

    @handler Metrics
    get /metrics returns (Envelope)
}

@server(
    prefix: /api/core
    group: core/system
)
service backend {
    @handler Config
    get /system/config returns (Envelope)
}

@server(
    prefix: /api/core
    group: core/system
    middleware: SessionAuth, Permission
)
service backend {
    @handler RuntimeMetrics
    get /system/runtime-metrics returns (Envelope)

    @handler LoginSessionDurationGet
    get /system/login-session-duration returns (Envelope)

    @handler LoginSessionDurationPut
    put /system/login-session-duration (SystemLoginSessionDurationReq) returns (Envelope)
}
