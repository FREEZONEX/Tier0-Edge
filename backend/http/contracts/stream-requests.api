syntax = "v1"

type StreamRequestDiscoverReq {
 page int64 `json:"page,optional"`
 size int64 `json:"size,optional"`
 search string `json:"search,optional"`
}

type PublicStreamRequest {
 code string `json:"code"`
 name string `json:"name"`
 description string `json:"description"`
 contractVersion string `json:"contractVersion"`
 inputSchema map[string]interface{} `json:"inputSchema"`
 outputSchema map[string]interface{} `json:"outputSchema"`
 sideEffect string `json:"sideEffect"`
 idempotency string `json:"idempotency"`
 timeoutMs int64 `json:"timeoutMs"`
 status string `json:"status"`
}

type StreamRequestDiscoverResp {
 total int64 `json:"total"`
 list []PublicStreamRequest `json:"list"`
}

type StreamRequestDescribeReq {
 requestCode string `path:"requestCode"`
}

type StreamRequestInvokeReq {
 requestCode string `path:"requestCode"`
 input interface{} `json:"input"`
 idempotencyKey string `json:"idempotencyKey,optional"`
}

type StreamRequestInvokeResp {
 code string `json:"code"`
 contractVersion string `json:"contractVersion"`
 result interface{} `json:"result"`
 runID string `json:"runID"`
 status string `json:"status"`
 replayed bool `json:"replayed"`
}
