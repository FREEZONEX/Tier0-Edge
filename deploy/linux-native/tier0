#!/usr/bin/env bash
set -euo pipefail
umask 077
program=$(cd -- "$(dirname -- "$0")" && pwd -P)
node="$program/node/node"
if [[ ${1:-help} == help || ${1:-} == --help ]]; then
  echo 'tier0 start|run|stop|status|logs [service]|uninstall [--yes]'
  echo 'start: background and wait for ready; run: foreground for a service manager; stop: retain all data.'
  exit 0
fi
[[ $EUID != 0 ]] || { echo 'Use the installing non-root user' >&2; exit 1; }
root=$("$node" -p 'require(process.argv[1]).dataRoot' "$program/.installation.json")
offset=$("$node" -p 'require(process.argv[1]).portOffset' "$program/.installation.json")
args=(--root "$root" --no-browser)
if [[ $offset != -1 ]]; then args+=(--port-offset "$offset"); fi
case "$1" in
  uninstall)
    [[ $# == 1 || $# == 2 && $2 == --yes ]] || { echo 'Use tier0 uninstall [--yes]' >&2; exit 2; }
    "$node" "$program/uninstall.mjs" --check "$program"
    if [[ ${2:-} != --yes ]]; then
      [[ -t 0 ]] || { echo 'Use --yes for non-interactive uninstall (data is retained)' >&2; exit 2; }
      read -r -p 'Stop this installation and remove its program files? Data is retained. [y/N] ' answer
      [[ $answer == y || $answer == Y ]] || exit 0
    fi
    if [[ -d $root/state ]]; then "$0" stop; fi
    mkdir -p "$root/state"
    exec 9>"$root/state/supervisor.lock"
    flock -n 9 || { echo 'Installation is running or restarting; stop/disable its service manager before uninstall' >&2; exit 1; }
    "$node" "$program/uninstall.mjs" --remove "$program"
    exit 0;;
  run) exec "$program/native-launcher" "${args[@]}";;
  start)
    mkdir -p "$root/state" "$root/logs"
    flock -n "$root/state/supervisor.lock" true || { echo 'This installation is already running'; exit 1; }
    # Keep launcher output bounded across starts; service logs are read through the runtime API.
    if [[ -f $root/logs/launcher.log ]]; then mv -f "$root/logs/launcher.log" "$root/logs/launcher.previous.log"; fi
    nohup setsid "$program/native-launcher" "${args[@]}" >"$root/logs/launcher.log" 2>&1 </dev/null &
    pid=$!
    for ((i=0;i<240;i++)); do
      if ! kill -0 "$pid" 2>/dev/null; then tail -n 60 "$root/logs/launcher.log"; wait "$pid"; exit 1; fi
      phase=$("$node" -e 'try{const p=require(process.argv[1]);if(p.pid===Number(process.argv[2]))console.log(p.phase)}catch{}' "$root/state/startup-progress.json" "$pid")
      if [[ $phase == ready ]]; then "$0" status; exit 0; fi
      sleep 1
    done
    echo "Startup still pending; inspect $root/logs/launcher.log and tier0 status" >&2; exit 1;;
  stop)
    "$program/native-launcher" --root "$root" --stop
    for ((i=0;i<180;i++)); do
      if flock -n "$root/state/supervisor.lock" true; then echo 'Stopped; data retained'; exit 0; fi
      sleep 1
    done
    echo 'Stop timed out; inspect service logs; no unrelated process was signaled' >&2; exit 1;;
  status)
    if [[ ! -f $root/state/startup-progress.json ]]; then
      echo 'No startup progress yet. Run tier0 start to initialize this installation.'
      exit 0
    fi
    "$node" -e 'const p=require(process.argv[1]);console.log(p.phase+": "+p.message);for(const s of p.services)console.log(s.id+": "+s.state+" "+(s.message||""))' "$root/state/startup-progress.json"
    if [[ ! -f $root/state/supervisor.lock ]] || (flock -n 9) 9<"$root/state/supervisor.lock"; then
      echo 'Supervisor is not running (above is last saved progress)'
    fi;;
  logs)
    service=${2:-launcher}
    case "$service" in launcher|backend|postgres|nats|mqtt|opcua|modbus|executor|fleet|initdb|createdb) ;; *) echo 'Unknown service' >&2; exit 2;; esac
    tail -n 200 -- "$root/logs/$service.log";;
  *) echo 'Unknown command; use --help' >&2; exit 2;;
esac
